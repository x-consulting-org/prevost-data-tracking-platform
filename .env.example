# Copy to .env and fill in. src/instrumentation.ts checks these when the server starts.
DATABASE_URL="postgresql://prevost:prevost@localhost:5432/prevost_tracking"
# At least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# The URL users open. Must be https in production, or the session cookies lose `Secure`.
BETTER_AUTH_URL="http://localhost:3000"
# Password of the seeded demo user (demo@prevost.example), at least 12 characters.
DEMO_USER_PASSWORD=""
